{
  "name": "@wobble/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --packages=external --alias:@wobble/shared=../shared/src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "loadtest": "tsx test/loadtest.ts",
    "bots": "tsx test/bots.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@colyseus/schema": "2.0.37",
    "colyseus": "0.15.57",
    "@colyseus/core": "0.15.57",
    "@colyseus/ws-transport": "0.15.3",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.10.0",
    "colyseus.js": "0.15.28",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
