{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true,
    "useDefineForClassFields": false, "experimentalDecorators": true,
