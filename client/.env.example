# WebSocket URL of the multiplayer server. Leave empty to use:
#   dev:  ws(s)://<page hostname>:2567
#   prod: same origin as the page (when the server also serves the client)
VITE_SERVER_URL=

# Optional TURN relay for voice chat (players behind strict NAT / mobile carriers).
# Comma-separate several URLs, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_PASS=
